<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Biometric authentication permission -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Package visibility for wallet apps (Android 11+) -->
    <queries>
        <package android:name="io.metamask" />
    </queries>

    <application
        android:name=".HealthWalletApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlockchainHealthWallet"
        android:usesCleartextTraffic="true"
        tools:targetApi="31"
        tools:replace="android:dataExtractionRules">
        <!-- Main Activity - Launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link for WalletConnect callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="healthwallet" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MedicationActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        
        <activity
            android:name=".AddMedicationActivity"
            android:exported="false"
            android:label="Add Medication"
            android:parentActivityName=".MedicationActivity" />
        
        <activity
            android:name=".ViewMedicationActivity"
            android:exported="false"
            android:label="Medication Details"
            android:parentActivityName=".MedicationActivity" />
        
        <activity
            android:name=".VaccinationRecordActivity"
            android:exported="false"
            android:label="疫苗紀錄" />
        <activity
            android:name=".AddVaccinationActivity"
            android:exported="false"
            android:parentActivityName=".VaccinationRecordActivity" />
        <activity
            android:name=".VaccinationDetailActivity"
            android:exported="false"
            android:label="疫苗紀錄詳情" />
        <activity
            android:name=".ViewVaccinationActivity"
            android:exported="false"
            android:label="Vaccination Details"
            android:parentActivityName=".VaccinationRecordActivity" />
        <activity
            android:name=".PdfViewerActivity"
            android:exported="false"
            android:label="PDF Viewer" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ReportsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".AddReportActivity"
            android:exported="false"
            android:parentActivityName=".ReportsActivity" />
        <activity
            android:name=".ViewReportActivity"
            android:exported="false"
            android:parentActivityName=".ReportsActivity" />
        <activity
            android:name=".ImageViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.BlockchainHealthWallet.Fullscreen"
            android:parentActivityName=".ViewReportActivity" />
        <activity
            android:name=".ShareRecordActivity"
            android:exported="false"
            android:label="Share Records" />
        <activity
            android:name=".FullShareHubActivity"
            android:exported="false"
            android:label="Full Record Sharing"
            android:parentActivityName=".ShareRecordActivity" />
        <activity
            android:name=".PartialShareHubActivity"
            android:exported="false"
            android:label="Partial Record Sharing"
            android:parentActivityName=".ShareRecordActivity" />
        <activity
            android:name=".SharedRecordsActivity"
            android:exported="false"
            android:label="Records I Shared" />
        <activity
            android:name=".ReceivedRecordsActivity"
            android:exported="false"
            android:label="Records I Received" />
        <activity
            android:name=".ViewReceivedReportActivity"
            android:exported="false"
            android:label="Received Report"
            android:parentActivityName=".ReceivedRecordsActivity" />
        <activity
            android:name=".ViewReceivedMedicationActivity"
            android:exported="false"
            android:label="Received Medication"
            android:parentActivityName=".ReceivedRecordsActivity" />
        <activity
            android:name=".ViewReceivedVaccinationActivity"
            android:exported="false"
            android:label="Received Vaccination"
            android:parentActivityName=".ReceivedRecordsActivity" />
        <activity
            android:name=".ShareRecordDetailActivity"
            android:exported="false"
            android:label="Share Details" />
        <activity
            android:name=".QRCodeDisplayActivity"
            android:exported="false"
            android:label="Share QR Code"
            android:parentActivityName=".ShareRecordDetailActivity" />
        <activity
            android:name=".QRScannerActivity"
            android:exported="false"
            android:label="Scan QR Code"
            android:screenOrientation="portrait"
            android:parentActivityName=".ReceivedRecordsActivity" />
        <activity
            android:name=".RecordSelectorActivity"
            android:exported="false"
            android:label="Select Record"
            android:parentActivityName=".ShareRecordActivity" />
        <activity
            android:name=".ShareFormActivity"
            android:exported="false"
            android:label="Share Record"
            android:parentActivityName=".RecordSelectorActivity" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".WalletInfoActivity"
            android:exported="false"
            android:label="Wallet Information"
            android:parentActivityName=".MainActivity" />
        
        <!-- Partial Share Activities -->
        <activity
            android:name=".ui.partialshare.PartialShareHubActivity"
            android:exported="false"
            android:label="Partial Share" />
        <activity
            android:name=".ui.partialshare.PartialShareSelectorActivity"
            android:exported="false"
            android:label="Select Record to Share" />
        <activity
            android:name=".ui.partialshare.PartialShareActivity"
            android:exported="false"
            android:label="Partial Share" />
        <activity
            android:name=".ui.partialshare.ScanPartialShareActivity"
            android:exported="false"
            android:label="Scan Shared Data"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.partialshare.AddressQRScannerActivity"
            android:exported="false"
            android:label="Scan Wallet Address"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.partialshare.ViewSharedWithMeActivity"
            android:exported="false"
            android:label="Shared With Me" />
        <activity
            android:name=".ui.partialshare.ViewScannedQRSharesActivity"
            android:exported="false"
            android:label="Scanned QR Records" />
        <activity
            android:name=".ui.partialshare.ViewSentPartialSharesActivity"
            android:exported="false"
            android:label="Partial Shares I Sent" />
        <activity
            android:name=".ui.partialshare.PartialShareDetailActivity"
            android:exported="false"
            android:label="Partial Share Details" />
        <activity
            android:name=".AgeVerifyActivity"
            android:exported="false"
            android:label="Age Verification"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".VaccineVerifyActivity"
            android:exported="false"
            android:label="Vaccine ZKP Verification"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".VaccinePassportActivity"
            android:exported="false"
            android:label="Vaccine Passport"
            android:parentActivityName=".MainActivity" />
        
        <!-- FileProvider for sharing decrypted files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>