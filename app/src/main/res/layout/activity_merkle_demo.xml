<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dynamic Merkle Tree Partial Share"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <CheckBox android:id="@+id/cbMedicine" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Medicine Name (medicineName)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etMedicine" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aspirin" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <CheckBox android:id="@+id/cbDosage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Dosage (dosage)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDosage" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="100mg" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <CheckBox android:id="@+id/cbDoctor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="false" />
            <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Doctor (prescribedBy)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etDoctor" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dr. Smith" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <Button android:id="@+id/btnGenerateMerkle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. Generate Tree &amp; Partial Proof" android:backgroundTint="#4CAF50" android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generated Root &amp; Proof Mapping JSON (EDIT TO TAMPER!):"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <EditText android:id="@+id/etMerkleJson"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:background="#EEEEEE"
            android:padding="8dp"
            android:textSize="12sp"
            android:typeface="monospace"/>

        <Button android:id="@+id/btnVerifyMerkle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2. Verify Partial Proof" android:backgroundTint="#2196F3" android:layout_marginTop="8dp"/>

        <TextView android:id="@+id/tvVerifyResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verification Result: Pending..."
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:padding="12dp"
            android:background="#D3D3D3" />

    </LinearLayout>
</ScrollView>