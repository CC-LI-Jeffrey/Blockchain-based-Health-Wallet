<?xml version="1.0" encoding="utf-8"?>
<!-- filepath: c:\Users\User\AndroidStudioProjects\Blockchain-based-Health-Wallet\app\src\main\res\layout\activity_partial_share.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Partial Share"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Record Type -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Record Type"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <Spinner
            android:id="@+id/recordTypeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"/>

        <!-- Attributes Selection -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Attributes to Share"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <LinearLayout
            android:id="@+id/attributesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"/>

        <!-- Share Method -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share Method"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <RadioGroup
            android:id="@+id/shareMethodGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/qrCodeRadio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QR Code (Instant)"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/blockchainRadio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Blockchain (Persistent)"/>
        </RadioGroup>

        <!-- Receiver Address (for blockchain method) -->
        <EditText
            android:id="@+id/receiverAddressInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Receiver Wallet Address"
            android:visibility="gone"
            android:layout_marginTop="8dp"/>

        <!-- Expiry Time -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expiry Hours"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/expiryHoursInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="24"
            android:inputType="number"
            android:text="24"/>

        <!-- Generate Button -->
        <Button
            android:id="@+id/generateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate Share"
            android:layout_marginTop="16dp"/>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="16dp"/>

        <!-- Status Text -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textAlignment="center"
            android:layout_marginTop="8dp"/>

        <!-- QR Code Image -->
        <ImageView
            android:id="@+id/qrCodeImage"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:scaleType="fitCenter"/>

    </LinearLayout>
</ScrollView>
