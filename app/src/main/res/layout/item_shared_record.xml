<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Record ID -->
        <TextView
            android:id="@+id/recordIdText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Record #0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

        <!-- Owner Address -->
        <TextView
            android:id="@+id/ownerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="From: 0x1234..."
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary" />

        <!-- Expiry Time -->
        <TextView
            android:id="@+id/expiryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Expires: Jan 01, 2026"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- IPFS Hash -->
        <TextView
            android:id="@+id/ipfsHashText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="IPFS: bafkrei..."
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:fontFamily="monospace" />

        <!-- Action hint -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tap to view details"
            android:textSize="12sp"
            android:textColor="?attr/colorPrimary"
            android:textStyle="italic" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
